RECIPEBOX_IMAGE=<registry>/<namespace>/<repository>:<version-tag>
PUBLIC_URL=<public-origin>
AUTH_MODE=<local-or-oidc>
SESSION_SECRET=<random-secret-of-at-least-32-characters>
ALLOW_LOCAL_REGISTRATION=<true-or-false>
OIDC_ISSUER=<https-issuer-url>
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_REDIRECT_URI=<public-origin>/auth/oidc/callback
ALLOWED_OIDC_GROUP=
TRUST_PROXY=0
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
APP_VERSION=<version-tag>
